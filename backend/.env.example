# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too

# Database — SQLite by default; point at Postgres for production
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/reporting

# CORS — the Vite dev server origin
CORS_ORIGINS=http://localhost:5173

# Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=32

# Outgoing mail (expiry alerts). Leave MAIL_ENABLED=false to log instead of send.
MAIL_ENABLED=false
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@sgs.com

# Block submitting a report while required check-points are blank.
# Leave false while testing the form; set true for a real deployment.
ENFORCE_REQUIRED_FIELDS=false

# Certification expiry alert thresholds (days before expiry)
ALERT_THRESHOLDS=60,30,7
